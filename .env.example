# Database Configuration (Supabase PostgreSQL)
# Note: For production on Render/Railway/AWS, use the IPv4 connection pooler on port 6543:
DATABASE_URL=postgresql://postgres.skfjnwiyhtknluqtipff:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or session pooler:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.skfjnwiyhtknluqtipff.supabase.co:6543/postgres

# Flask Session Security Key
SECRET_KEY=your-production-secret-key-here

# Groq Cloud API Key for AI Insights & Transcription
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase Auth Configuration
SUPABASE_URL=https://skfjnwiyhtknluqtipff.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Frontend URL for CORS (e.g., your Vercel deployment URL)
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Server Port (Default 5000)
PORT=5000
